[{"id":"9c8a7f4d24adaab3","text":"Talk is cheap. Show me the code.","category":"internet","work":"Linux Kernel Mailing List","author":"Linus Torvalds","speaker":"Linus Torvalds","location":"LKML, 2000-08-25","source_url":"https://lkml.org/lkml/2000/8/25/132","license":"fair-use-short-quote","language":"en","tags":["programming","quote"],"retrieved_at":"2026-10-24T21:50:00+08:00","verified":true},{"id":"4fc424a614a9ef65","text":"Stay hungry, stay foolish.","category":"internet","work":"Stanford Commencement Address","author":"Steve Jobs","speaker":"Steve Jobs","location":"2005 Stanford Commencement, 结尾","source_url":"https://news.stanford.edu/2005/06/12/youve-got-find-love-jobs-says/","license":"fair-use-short-quote","language":"en","tags":["speech","life"],"retrieved_at":"2026-10-24T21:50:00+08:00","verified":true},{"id":"d31e3fc01b42949b","text":"Premature optimization is the root of all evil.","category":"internet","work":"Structured Programming with go to Statements","author":"Donald E. Knuth","speaker":"","location":"ACM Computing Surveys, 1974, p. 268","source_url":"https://dl.acm.org/doi/10.1145/356635.356640","license":"fair-use-short-quote","language":"en","tags":["programming","paper"],"retrieved_at":"2026-10-24T21:50:00+08:00","verified":true},{"id":"b82f710a170aab48","text":"所有大人都曾经是小孩（但是很少有人记得它）。","category":"internet","work":"小王子","author":"安托万·德·圣埃克苏佩里","speaker":"","location":"维基语录·小王子·作者","source_url":"https://zh.wikiquote.org/wiki/小王子","license":"CC-BY-SA-4.0","language":"zh","tags":["小王子","童心"],"retrieved_at":"2026-10-24T21:50:00+08:00","verified":false},{"id":"908e801646987306","text":"衷悲所以哀其不幸，疾视所以怒其不争。","category":"internet","work":"摩罗诗力说","author":"鲁迅","speaker":"","location":"维基语录·鲁迅","source_url":"https://zh.wikiquote.org/wiki/鲁迅","license":"CC-BY-SA-4.0","language":"zh","tags":["鲁迅","文论"],"retrieved_at":"2026-10-24T21:50:00+08:00","verified":false},{"id":"ff693b44a2412b68","text":"寄意寒星荃不察，我以我血荐轩辕。","category":"internet","work":"自题小像","author