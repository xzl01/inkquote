[{"id":"defb476f9b768ea0","text":"Life is like a box of chocolates. You never know what you're gonna get.","category":"movie","work":"Forrest Gump","author":"Robert Zemeckis","speaker":"Forrest Gump","location":"开场长椅场景（约 00:02:30）","source_url":"https://www.imdb.com/title/tt0109830/quotes/","license":"fair-use-short-quote","language":"en","tags":["life","经典"],"retrieved_at":"2026-10-24T21:50:00+08:00","verified":false},{"id":"17897059fd0c48de","text":"Hope is a good thing, maybe the best of things, and no good thing ever dies.","category":"movie","work":"The Shawshank Redemption","author":"Frank Darabont","speaker":"Andy Dufresne","location":"片尾 Andy 的信（约 02:13:00）","source_url":"https://www.imdb.com/title/tt0111161/quotes/","license":"fair-use-short-quote","language":"en","tags":["hope","经典"],"retrieved_at":"2026-10-24T21:50:00+08:00","verified":false},{"id":"90aeff8a3c96e691","text":"希望是美好的事物，也许是世上最美好的事物，美好的事物从不消逝。","category":"movie","work":"肖申克的救赎","author":"弗兰克·德拉邦特","speaker":"安迪·杜佛兰","location":"片尾安迪的信（约 02:13:00）","source_url":"https://www.imdb.com/title/tt0111161/quotes/","license":"fair-use-short-quote","language":"zh","tags":["希望","待核对"],"retrieved_at":"2026-10-24T21:50:00+08:00","verified":false}]