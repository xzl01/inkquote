{"author": "庄周", "category": "book", "id": "d3b6b6b659f36643", "language": "zh", "license": "public-domain", "location": "逍遥游", "retrieved_at": "2026-10-24T21:50:00+08:00", "source_url": "https://zh.wikisource.org/wiki/莊子/逍遙遊", "speaker": "", "tags": ["道家", "想象"], "text": "鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里。", "verified": true, "work": "庄子"}
