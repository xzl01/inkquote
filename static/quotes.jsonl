{"author": "孔子及其弟子", "category": "book", "id": "658f38f008665ceb", "language": "zh", "license": "public-domain", "location": "为政第二", "retrieved_at": "2026-10-24T23:20:00+08:00", "source_url": "https://zh.wikisource.org/wiki/論語/為政第二", "speaker": "", "tags": ["儒家", "学习"], "text": "学而不思则罔，思而不学则殆。", "verified": true, "work": "论语"}
{"author": "孔子及其弟子", "category": "book", "id": "7e0aed26ffca1f43", "language": "zh", "license": "public-domain", "location": "述而第七", "retrieved_at": "2026-10-24T23:20:00+08:00", "source_url": "https://zh.wikisource.org/wiki/論語/述而第七", "speaker": "", "tags": ["儒家", "修养"], "text": "君子坦荡荡，小人长戚戚。", "verified": true, "work": "论语"}
