{"author": "洪应明", "category": "book", "id": "acb666edc7b26d87", "language": "zh", "license": "public-domain", "location": "修身篇", "retrieved_at": "2026-10-24T21:50:00+08:00", "source_url": "https://zh.wikisource.org/wiki/菜根譚", "speaker": "", "tags": ["处世", "心境"], "text": "宠辱不惊，闲看庭前花开花落；去留无意，漫随天外云卷云舒。", "verified": true, "work": "菜根谭"}
{"author": "孔子及其弟子", "category": "book", "id": "14f3beadb39b7ae2", "language": "zh", "license": "public-domain", "location": "颜渊第十二", "retrieved_at": "2026-10-24T23:20:00+08:00", "source_url": "https://zh.wikisource.org/wiki/論語/顏淵第十二", "speaker": "", "tags": ["儒家", "处世"], "text": "己所不欲，勿施于人。", "verified": true, "work": "论语"}
